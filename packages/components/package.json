{
  "name": "@hermeum/components",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./index.css": "./index.css",
    "./ui/*": "./ui/*.tsx",
    "./lib/*": "./lib/*.ts",
    "./hooks/*": "./hooks/*.ts"
  },
  "scripts": {
    "add": "shadcn add --overwrite",
