    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@hermeum/eslint-config": "workspace:*",
    "@hermeum/typescript-config": "workspace:*",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "shadcn": "^4.2.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.8.2"
