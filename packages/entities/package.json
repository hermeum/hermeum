{
  "name": "@kubeclaw/entities",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@kubernetes/client-node": "^1.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@kubeclaw/eslint-config": "workspace:*",
    "eslint": "^9.0.0",
    "@kubeclaw/typescript-config": "workspace:*",
    "typescript": "^5.8.2"
  }
}
