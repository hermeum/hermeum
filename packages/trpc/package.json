{
  "name": "@kubebox/trpc",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@kubebox/entities": "workspace:*",
    "@trpc/server": "^11.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@kubebox/eslint-config": "workspace:*",
    "eslint": "^9.0.0",
    "@kubebox/typescript-config": "workspace:*",
    "typescript": "^5.8.2"
  }
}
