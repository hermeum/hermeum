{
  "name": "@kubeclaw/dashboard",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/server.ts",
    "build": "vite build & vite build --mode server & vite build --mode cmd & wait",
    "start": "NODE_ENV=production tsx src/server/server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "better-auth:generate": "pnpm dlx auth generate --config src/server/infras/better-auth/auth.ts --output src/server/infras/better-auth/schema.ts",
    "drizzle:generate": "drizzle-kit generate ",
    "drizzle:migrate": "drizzle-kit migrate",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@kubeclaw/components": "workspace:*",
    "@kubernetes/client-node": "^1.4.0",
    "@tanstack/react-form": "^1.29.0",
    "@tanstack/react-query": "^5.67.3",
    "@tanstack/react-router": "^1.114.22",
    "@trpc/client": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "@trpc/tanstack-react-query": "^11.15.0",
    "@uiw/react-codemirror": "^4.25.9",
    "better-auth": "^1.6.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "fast-json-patch": "^3.1.1",
    "lucide-react": "^1.8.0",
    "nodemailer": "^8.0.5",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7",
    "superjson": "^2.2.6",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@kubeclaw/eslint-config": "workspace:*",
    "@kubeclaw/typescript-config": "workspace:*",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/router-plugin": "^1.114.22",
    "@types/express": "^4.17.21",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
