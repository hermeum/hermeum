{
  "name": "@hermeum/app",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/server/server.ts",
    "build": "vite build & vite build --mode server & vite build --mode cmd & wait",
    "start": "NODE_ENV=production tsx src/server/server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "better-auth:generate": "pnpm dlx auth generate --config src/server/routers/better-auth/auth.ts --output src/server/routers/better-auth/schema.${HERMEUM_DATABASE_DIALECT:-sqlite}.ts --yes",
    "drizzle:generate": "drizzle-kit generate --config drizzle.config.${HERMEUM_DATABASE_DIALECT:-sqlite}.ts",
    "drizzle:migrate": "drizzle-kit migrate --config drizzle.config.${HERMEUM_DATABASE_DIALECT:-sqlite}.ts",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.92",
    "@ai-sdk/react": "^4.0.141",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/merge": "^6.12.2",
    "@hermeum/components": "workspace:*",
    "@kubernetes/client-node": "^2.0.0",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@replit/codemirror-indentation-markers": "^6.5.3",
    "@tanstack/react-form": "^1.29.0",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.42",
    "@tanstack/react-virtual": "^3.14.17",
    "@trpc/client": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@trpc/tanstack-react-query": "^11.19.0",
    "@uiw/react-codemirror": "^4.25.12",
    "ai": "^7.0.138",
    "better-auth": "^1.7.7",
    "better-sqlite3": "^13.0.3",
    "date-fns": "^4.1.0",
    "dotenv": "^18.0.7",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "fast-json-patch": "^3.1.1",
    "lucide-react": "^1.55.0",
    "nodemailer": "^10.1.0",
    "postgres": "^3.4.9",
    "posthog-node": "^5.55.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.7",
    "streamdown": "^2.7.0",
    "superjson": "^2.2.6",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hermeum/eslint-config": "workspace:*",
    "@hermeum/typescript-config": "workspace:*",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/router-plugin": "^1.168.43",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.0.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.4"
  }
}
