{
  "name": "@hermeum/app",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/server/server.ts",
    "build": "vite build & a=$!; vite build --mode server & b=$!; vite build --mode cmd & c=$!; wait $a && wait $b && wait $c",
    "start": "NODE_ENV=production tsx src/server/server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "better-auth:generate": "pnpm dlx auth generate --config src/server/routers/better-auth/auth.ts --output src/server/routers/better-auth/schema.${HERMEUM_DATABASE_DIALECT:-sqlite}.ts --yes",
    "drizzle:generate": "drizzle-kit generate --config drizzle.config.${HERMEUM_DATABASE_DIALECT:-sqlite}.ts",
    "drizzle:migrate": "drizzle-kit migrate --config drizzle.config.${HERMEUM_DATABASE_DIALECT:-sqlite}.ts",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.111",
    "@ai-sdk/react": "^4.0.170",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/merge": "^6.12.3",
    "@hermeum/components": "workspace:*",
    "@kubernetes/client-node": "^2.0.2",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.301.1",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.1",
    "@replit/codemirror-indentation-markers": "^6.5.3",
    "@tanstack/react-form": "^1.29.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-virtual": "^3.14.26",
    "@trpc/client": "^11.26.0",
    "@trpc/server": "^11.26.0",
    "@trpc/tanstack-react-query": "^11.26.0",
    "@uiw/react-codemirror": "^4.25.12",
    "ai": "^7.0.166",
    "better-auth": "^1.7.18",
    "better-sqlite3": "^13.0.3",
    "date-fns": "^4.1.0",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "fast-json-patch": "^3.1.1",
    "lucide-react": "^1.70.0",
    "nodemailer": "^10.4.0",
    "postgres": "^4.1.0",
    "posthog-node": "^5.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.7",
    "streamdown": "^2.7.1",
    "superjson": "^2.2.6",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hermeum/eslint-config": "workspace:*",
    "@hermeum/typescript-config": "workspace:*",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/router-plugin": "^1.169.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.0.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.7",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.0"
  }
}
